HOST=127.0.0.1
PORT=3000
APP_TIMEZONE=Europe/London
DISPLAY_LATITUDE=51.0000
DISPLAY_LONGITUDE=-0.1000
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REFRESH_TOKEN=replace-me
GOOGLE_CALENDAR_FAMILY=replace-me
GOOGLE_CALENDAR_BAES=replace-me
EVENT_ID_SALT=replace-with-a-random-server-only-value
CALENDAR_CACHE_TTL_MS=300000
WEATHER_CACHE_TTL_MS=1800000
MEAL_CACHE_TTL_MS=300000
# Optional: set both values to enable the read-only Sous meal feed.
# SOUS_MEALS_URL=https://europe-west2-your-project.cloudfunctions.net/displayMeals
# SOUS_MEALS_TOKEN=replace-with-a-separate-random-feed-token
# Optional: set both values to enable the read-only morning quote endpoint.
# MORNING_QUOTE_URL=https://private.example/morning-quote
# MORNING_QUOTE_TOKEN=replace-with-a-separate-random-quote-token
